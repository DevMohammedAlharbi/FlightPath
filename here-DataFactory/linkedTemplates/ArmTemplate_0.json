			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Allows Azure to access my specific folder and its contained files (Local File System Sources)  ",
				"annotations": [],
				"type": "FileServer",
				"typeProperties": {
					"host": "[parameters('ls_onPrem_file_properties_typeProperties_host')]",
					"userId": "[parameters('ls_onPrem_file_properties_typeProperties_userId')]",
					"password": {
