{
	"name": "SQL_to_DataLake",
	"properties": {
		"activities": [
			{
				"name": "SQL RAW TO LAKE",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Look For lastload File and Comback",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Look For LatestLoad - max",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from dbo.FactBookings\nwhere booking_date > '@{ activity('Look For lastload File and Comback').output.firstRow.lastload }'\nAND booking_date <= '@{activity('Look For LatestLoad - max').output.firstRow.newest_booking_date}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "Dataset_FromSQL_Source",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_bronze_sql_parquet",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "Look For lastload File and Comback",
				"description": "Initial load= Full load",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_LOOKUP_For_File_in_Lake",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Look For LatestLoad - max",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select MAX(booking_date) as newest_booking_date\nFROM dbo.FactBookings",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "Dataset_FromSQL_Source",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Update Watermark",
				"description": "READ FROM EMPTY .",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "SQL RAW TO LAKE",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"additionalColumns": [
							{
								"name": "lastload",
								"value": {
									"value": "@activity('Look For LatestLoad - max').output.firstRow.newest_booking_date",
									"type": "Expression"
								}
							}
						],
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ReadEmpty",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_LOOKUP_For_File_in_Lake",
						"type": "DatasetReference"
					}
				]
			}
		],
		"variables": {
			"ValueToSet": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-24T20:29:26Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}